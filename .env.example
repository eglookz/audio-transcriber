# Copy this file to .env and paste your keys.

# OpenRouter: the default model and every other OpenRouter speech-to-text model.
# Get one at https://openrouter.ai/settings/keys
OPENROUTER_API_KEY=sk-or-v1-...

# OpenAI: only for the OpenAI models (whisper-1, gpt-transcribe, gpt-4o-transcribe-diarize, ...).
# Get one at https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-proj-...
